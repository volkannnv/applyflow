# Local development. Production must set NODE_ENV=production and HTTPS APP_ORIGINS.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=data/applyflow.sqlite
# Optional locally; required in production. Netlify: use Neon's pooled URL with sslmode=require.
# DATABASE_URL=postgresql://user:password@host:5432/applyflow
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001,http://localhost:3001
